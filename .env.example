# Copy to .env for local development. Never commit real secrets.

# --- LLM provider (used by the agent orchestrator, app/, scripts/agent_smoke_test.py) ---
# "gemini" (default/primary in production) and "groq" are both supported; the interface in
# llm/base.py is designed so another provider can be added later without changing agent/ code.
LLM_PROVIDER=gemini

# Gemini (llm/gemini_provider.py), used when LLM_PROVIDER=gemini:
# Get a free key at https://aistudio.google.com/apikey. Required for the agent to answer for
# real; the app still starts and /health still works without it (llm_configured will read false).
GEMINI_API_KEY=
# Optional: defaults to llm/gemini_provider.py's DEFAULT_GEMINI_MODEL if left unset.
GEMINI_MODEL=gemini-3.8-flash

# Groq (llm/groq_provider.py), used when LLM_PROVIDER=groq -- fully supported as an
# alternative, just not the default. Get a free key at https://console.groq.com/keys.
GROQ_API_KEY=
# Optional: defaults to a current Groq-hosted tool-calling-capable model (see
# llm/groq_provider.py's DEFAULT_GROQ_MODEL) if left unset.
GROQ_MODEL=

# Shared by both providers.
# Low/near-deterministic by default, appropriate for HR policy answers.
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30

# End-to-end ceiling (seconds) on a single /chat request's whole agent loop
# (every LLM turn + MCP tool call in it) -- see app/main.py. Distinct from
# LLM_TIMEOUT_SECONDS, which bounds one LLM call.
AGENT_RUN_TIMEOUT_SECONDS=60

# --- RAG / embeddings ---
# "fastembed" (default): real local dense embeddings via ONNX Runtime, no
#   torch/CUDA dependency. Requires network access to download model
#   weights on first use (see design-and-evaluation.md for why this
#   replaced the sentence-transformers package named in CLAUDE.md's
#   preferred stack).
# "hashing": dependency-free, fully deterministic bag-of-words fallback
#   used by the automated test suite and available as an offline fallback.
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HASHING_EMBEDDING_DIM=384

# Chunking (characters, not tokens - see rag/chunking.py for rationale).
RAG_MAX_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP_CHARS=150

# Retrieval.
RAG_DEFAULT_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.2

# Where the persisted vector index lives. Leave unset to use the default
# (rag_index/ at the project root); override for tests or alternate builds.
# RAG_INDEX_DIR=

# --- MCP (mcp_server/, mcp_client/) ---
MCP_TRANSPORT=stdio

# Where confirmed mock HR tickets are persisted (gitignored; never the
# committed mock_data/hr_tickets.json fixture). Leave unset for the default.
# HR_COMPASS_RUNTIME_TICKETS_PATH=
